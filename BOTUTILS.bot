SCRIPT.SetAttribute('case-sensitive', FALSE)    ~ This line has to be capitalised properly ;
~ Non-case-sensitive - capitalise however you want. (Default. Set just in case)
  I personally prefer a bunch of capitals but variables (not functions) and function parameters are lowercase (camelCase), along with
  attributes (camelCase) and string contents (normal text) ;
SCRIPT.SetAttribute('module', TRUE)


%DEFINE #OBJECT &CLASS FIRE -> {
	~ A class to store parameters for flamethrower fires (duration, DPS, ease to put out). ;
	%DEFINE #FUNCTION &OBJECT-CREATION () -> {
		%DEFINE #ATTRIBUTE &FLOAT &MULTIPLE -> {
			damage = 2.0   ~ Damage (typical HP for a creature (at the start) is 100). ;
			interval = 0.1 ~ Interval between target.fireTick() calls (in s).          ;
			ease = 0.05    ~ Ease to put out the fire (chance to put it out).          ;
		}
	}
}

%DEFINE #OBJECT &CLASS WEAPON -> {
	~ An object class for weapons, such as the starting flamethrower. ;
	%DEFINE #FUNCTION &OBJECT-CREATION (type) -> {
		%DEFINE #ATTRIBUTE &MULTIPLE -> {
			#STRING type = type
			IF (^type == 'flamethrower') -> {
				#OBJECT &FIRE fire = NEW FIRE()
				#FLOAT range = 5.0
				#INT magSize = 150     ~ Ammunition maximum capacity.                                                ;
				#FLOAT fireRate = 30.0 ~ Ammunition usage per second.                                                ;
				#FLOAT spread = 15.0   ~ Weapon's horisontal spread (in degrees).                                    ;
				#FLOAT speed = 5.0     ~ Initial speed of the projectiles when leaving the weapon's barrel (in m/s). ;
				#FLOAT timeUntilShoot = 0.0;
			} -> ELSEIF (^type == 'fists') -> {
				#FLOAT range = 1.25
				#INT magSize = 0
				#FLOAT fireRate = 0.4
				#FLOAT spread = 0.0
				#FLOAT speed = 100
				#FLOAT range = 1.0
				#FLOAT timeUntilShoot = 0.0
			}
		}
	}
}

%DEFINE #OBJECT &CLASS PLAYER -> {
	~ Player class (object class incase multiplayer gets added :D) ;
	%DEFINE #FUNCTION &OBJECT-CREATION -> {
		%DEFINE #ATTRIBUTE &MULTIPLE -> {
			#FLOAT &LIST pos = [0, 0]
			#FLOAT direction = 0
			#FLOAT hp = 100.0
			#FLOAT speed = 2.0
			#WEAPON &LIST weapons = SYSTEM.GETWEAPONS()
		}
		%DEFINE #BEHAVIOUR SCRIPT.eventListner('weapon' ~ all weapon events (new weapon, weapon stat changed, weapon removed, etc.);, #FUNCTION -> {
			^weapons = SYSTEM.GETWEAPONS()
		} -> NONE)
	}
}

%DEFINE #OBJECT &CLASS ENEMY -> {
	~ A class to make enemies ;
	%DEFINE #FUNCTION &OBJECT-CREATION (difficulty IS #FLOAT, type IS #STRING, pos IS #FLOAT &LIST) -> {
		%DEFINE #ATTRIBUTE &MULTIPLE -> {
			#STRING type = type
			#FLOAT difficulty = difficulty
			#FLOAT &LIST pos = pos
			#FLOAT direction = 0.0
			IF (^type == 'normal') -> {
				#FLOAT hp = 100.0 * ^difficulty
				#FLOAT speed = 1.0 * (0.875 + 0.125 * ^difficulty)
				#WEAPON weapon = NEW WEAPON('fists')
			}
		}
		%DEFINE #METHOD ATTACK (target IS #PLAYER) -> {
			IF (^weapon.type == 'fists' AND ((target.pos[0] - ^pos[0])**2 + (target.pos[1] - ^pos[1])**2)**0.5 <= ^weapon.range) -> {
				target.takeDamgae(5, 'physical')
			}
		} -> NONE
	}
}

%DEFINE #EXPORT &FUNCTION GETWEAPON (type IS #STRING) -> {
	%GET localPlayer <world.json>
	#WEAPON found = NONE
	FOR (#INT i = 0 -> i < localPlayer.weapons.length -> i++) -> {
		IF (localPlayer.weapons[i].type == type) -> {
			found = localPlayer.weapons[i]
		}
	}
} -> found

%DEFINE #EXPORT &FUNCTION TARGET (which IS #STRING, type IS #STRING) -> {
	#WEAPON weapon = GETWEAPON(type)
	IF (which == 'closest') -> {
		%GET closestEnemy(%GET localPlayer <world.json>) <world.json> AS target
	} -> ELSEIF (which == 'weakest') -> {
		%GET weakestEnemyInRange(%GET localPlayer <world.json>) <world.json> AS target
	} -> ELSEIF (which == 'strongest') -> {
		%GET strongestEnemyInRange(%GET localPlayer <world.json>) <world.json> AS target
	} -> ELSE -> {
	
	}
} -> target

%DEFINE #EXPORT &FUNCTION ATTACK (target IS #ENEMY, weapon IS #WEAPON) -> {
	IF (weapon.type == 'flamethrower' AND NOT target.fireImmunity) -> {
		target.onFire = TRUE
		target.fireTick(weapon.fire)
	} -> ELSE -> {

	}
} -> NONE
